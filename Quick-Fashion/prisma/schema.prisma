generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum AuctionModel {
  ENGLISH
  PENNY
  SEALED_BID
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSING
  CLOSED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  LOST
  REFUNDED
  VOIDED
}

enum LedgerEntryType {
  TOPUP
  BID_LOCK
  BID_RELEASE
  BID_WIN_DEDUCT
  BID_FEE_DEDUCT
  REFUND
  ADMIN_ADJUSTMENT
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  OUTBID
  AUCTION_WON
  AUCTION_ENDING_SOON
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum StoreOrderStatus {
  PAYMENT_PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  FULFILLED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum PersonalSpacePhotoKind {
  SELFIE
  FRONT
  LEFT
  RIGHT
  BACK
}

enum InteractionType {
  SEARCH
  PRODUCT_VIEW
  PRODUCT_DWELL
  SITE_DWELL
  CART_ADD
  AUCTION_WATCH
  BID
  PURCHASE
  FEED_IMPRESSION
  FEED_CLICK
  HIDE
}

enum AuctionEventType {
  BID_PLACED
  OUTBID
  TIMER_EXTENDED
  AUCTION_CLOSING_SOON
  AUCTION_CLOSED
}

enum FriendShipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  pixaSubjectId String?  @unique
  role          UserRole @default(BUYER)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())

  wallet              Wallet?
  products            Product[]
  bids                Bid[]
  paymentTransactions PaymentTransaction[]
  notifications       Notification[]
  watchedAuctions     AuctionWatcher[]
  storeOrders         StoreOrder[]
  profile             UserProfile?
  cart                Cart?
  measurement         Measurement?
  pixaConnection      PixaConnection?
  userInteractions    UserInteraction[]
  personalSpacePhotos PersonalSpacePhoto[]
  emailOtps           EmailOtp[]
  targetProducts      Product[]           @relation("TargetUserProducts")
  friendRequestsSent     FriendShip[]      @relation("FriendRequestsSent")
  friendRequestsReceived FriendShip[]      @relation("FriendRequestsReceived")
}

model PixaConnection {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenCiphertext String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Measurement {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pixaUpdatedAt DateTime?
  status        String    @default("AVAILABLE")
  unit          String    @default("CM")
  shoulderWidth Float?
  chest         Float?
  waist         Float?
  hip           Float?
  neck          Float?
  sleeveLength  Float?
  armLength     Float?
  thigh         Float?
  calf          Float?
  heightCm      Float?
  weightKg      Float?
  legLengthCm   Float?
  shoulderDepth Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  bio            String?
  gender         String?
  location       String?
  age            Int?
  dateOfBirth    DateTime?
  preferredSizes String[]
  defaultAddress Json?
  updatedAt      DateTime  @updatedAt
}

model PersonalSpacePhoto {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PersonalSpacePhotoKind
  width      Int
  height     Int
  originalKey String                 @unique
  variants   Json
  createdAt  DateTime               @default(now())

  @@unique([userId, kind])
  @@index([userId])
}

model EmailOtp {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model UserInteraction {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type       InteractionType
  query      String?
  durationMs Int?
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([productId, createdAt])
  @@index([categoryId, createdAt])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, size])
  @@index([cartId])
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  availableBalance BigInt   @default(0)
  lockedBalance    BigInt   @default(0)
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt

  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  type          LedgerEntryType
  amount        BigInt
  referenceId   String?
  referenceType String?
  balanceAfter  BigInt
  createdAt     DateTime        @default(now())

  @@index([walletId, createdAt])
}

model PaymentTransaction {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  provider         PaymentProvider
  gatewayPaymentId String          @unique
  amountInRupees   BigInt
  creditsGranted   BigInt
  status           PaymentStatus   @default(INITIATED)
  createdAt        DateTime        @default(now())
  reconciledAt     DateTime?
}

model Product {
  id             String    @id @default(uuid())
  sellerId       String
  seller         User      @relation(fields: [sellerId], references: [id])
  title          String
  description    String
  // Legacy-only source URLs. New application code never reads or writes this
  // column; `protectedImages` is the sole product-image source of truth.
  images         String[]
  priceInRupees  BigInt
  category       String    @default("OTHER")
  categoryId     String?
  categoryNode   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  availableSizes String[]
  stockQuantity  Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  auction         Auction?
  storeOrders     StoreOrder[]
  cartItems       CartItem[]
  storeOrderItems StoreOrderItem[]
  protectedImages ProductImage[]
  fitProfile      ProductFitProfile?
  interactions    UserInteraction[]

  targetUserId   String?
  targetUser     User?     @relation("TargetUserProducts", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([targetUserId])
}

model ProductFitProfile {
  id            String                    @id @default(uuid())
  productId     String                    @unique
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit          String                    @default("CM")
  shoulderWidth Float?
  chest         Float
  waist         Float
  hip           Float
  neck          Float
  sleeveLength  Float
  armLength     Float
  thigh         Float
  calf          Float
  // Managed by PostgreSQL/pgvector in the migration; Prisma reads the scalar measurements.
  fitVector     Unsupported("vector(9)")?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploaderId  String
  sortOrder   Int      @default(0)
  viewType    String   @default("FRONT")
  width       Int
  height      Int
  originalKey String   @unique
  variants    Json
  status      String   @default("STAGED")
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
  @@index([productId, viewType])
  @@index([uploaderId, status])
}

model Category {
  id           String            @id @default(uuid())
  name         String
  slug         String
  path         String            @unique
  parentId     String?
  parent       Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]        @relation("CategoryTree")
  products     Product[]
  interactions UserInteraction[]
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([parentId, slug])
  @@index([parentId, isActive, sortOrder])
}

model StoreOrder {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])
  size              String?
  quantity          Int              @default(1)
  subtotalPaise     BigInt
  shippingPaise     BigInt
  totalPaise        BigInt
  currency          String           @default("INR")
  status            StoreOrderStatus @default(PAYMENT_PENDING)
  razorpayOrderId   String           @unique
  razorpayPaymentId String?          @unique
  deliveryAddress   Json
  createdAt         DateTime         @default(now())
  paidAt            DateTime?
  updatedAt         DateTime         @updatedAt
  items             StoreOrderItem[]

  @@index([userId, createdAt])
  @@index([productId])
}

model StoreOrderItem {
  id             String     @id @default(uuid())
  storeOrderId   String
  storeOrder     StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  productTitle   String
  productImage   String?
  size           String
  quantity       Int
  unitPricePaise BigInt
  lineTotalPaise BigInt

  @@index([storeOrderId])
  @@index([productId])
}

model RazorpayWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Auction {
  id                       String        @id @default(uuid())
  productId                String        @unique
  product                  Product       @relation(fields: [productId], references: [id])
  auctionModel             AuctionModel
  status                   AuctionStatus @default(DRAFT)
  startTime                DateTime
  endTime                  DateTime
  currentHighestBidId      String?
  startingPriceCredits     BigInt
  minIncrement             BigInt        @default(1)
  bidFee                   BigInt?
  priceStepPerBid          BigInt?
  antiSnipingWindowSeconds Int           @default(30)
  version                  Int           @default(0)

  bids     Bid[]
  order    Order?
  watchers AuctionWatcher[]
  events   AuctionEvent[]

  @@index([status, endTime])
}

model AuctionWatcher {
  id        String   @id @default(uuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([auctionId, userId])
  @@index([auctionId])
}

model AuctionEvent {
  id        String           @id @default(uuid())
  auctionId String
  auction   Auction          @relation(fields: [auctionId], references: [id])
  type      AuctionEventType
  payload   Json
  createdAt DateTime         @default(now())

  @@index([auctionId, createdAt])
}

model Bid {
  id             String    @id @default(uuid())
  auctionId      String
  auction        Auction   @relation(fields: [auctionId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  amountCredits  BigInt
  status         BidStatus @default(ACTIVE)
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  wonOrder Order?

  @@index([auctionId, amountCredits])
}

model Order {
  id                String   @id @default(uuid())
  auctionId         String   @unique
  auction           Auction  @relation(fields: [auctionId], references: [id])
  winningBidId      String   @unique
  winningBid        Bid      @relation(fields: [winningBidId], references: [id])
  buyerId           String
  finalPriceCredits BigInt
  fulfillmentStatus String   @default("PENDING")
  createdAt         DateTime @default(now())
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  payload   Json
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
}

model FriendShip {
  id         String          @id @default(uuid())
  requesterId String
  addresseeId String
  requester  User        @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee  User        @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status     FriendShipStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  respondedAt DateTime?
  updatedAt  DateTime     @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@index([status, updatedAt])
}